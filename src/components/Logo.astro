---
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo-mark.png';
interface Props { size?: 'md' | 'sm'; href?: string }
const { size = 'md', href = '/' } = Astro.props;
---
<a href={href} class:list={['logo', `logo--${size}`]} aria-label="Peter Rebik — home">
  <Image src={mark} alt="" width={96} height={96} loading="eager" class="logo__mark" />
  <span class="logo__word">Peter Rebik</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55em; color: var(--accent); font-family: var(--font-display); line-height: 1; }
  .logo--md { font-size: clamp(1.375rem, 1rem + 1.2vw, 1.875rem); }
  .logo--sm { font-size: 1.25rem; }
  .logo__mark { width: 1.6em; height: 1.6em; transition: transform var(--dur-base) var(--ease-spring); }
  .logo:hover .logo__mark { transform: rotate(-12deg) scale(1.06); }
</style>

---
// PR icon + wordmark (Peter's PR icon, Nov 2026). The icon follows the wordmark colour.
import Icon from './Icon.astro';
interface Props { size?: 'md' | 'sm'; href?: string }
const { size = 'md', href = '/' } = Astro.props;
---
<a href={href} class:list={['logo', `logo--${size}`]} aria-label="Peter Rebik — home">
  <Icon name="pr-mark" class="logo__mark" />
  <span class="logo__word">Peter Rebik</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.32em; color: var(--accent); font-family: var(--font-heading); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); line-height: 1; }
  .logo--md { font-size: clamp(1.375rem, 1rem + 1.2vw, 1.875rem); }
  .logo--sm { font-size: 1.25rem; }
  .logo { transition: color 0.8s linear; }
  .logo :global(.logo__mark) { width: 1.05em; height: 1.05em; flex: none; }
</style>

---
// Name-only wordmark (Nov 2026). Peter dropped the swooping P mark: it was a Pierce Transit rebrand concept.
interface Props { size?: 'md' | 'sm'; href?: string }
const { size = 'md', href = '/' } = Astro.props;
---
<a href={href} class:list={['logo', `logo--${size}`]} aria-label="Peter Rebik — home">
  <span class="logo__word">Peter Rebik</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; color: var(--accent); font-family: var(--font-heading); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); line-height: 1; }
  .logo--md { font-size: clamp(1.375rem, 1rem + 1.2vw, 1.875rem); }
  .logo--sm { font-size: 1.25rem; }
  .logo { transition: color 0.8s linear; }
</style>

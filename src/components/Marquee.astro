---
import { site } from '../data/site';
const words = site.marquee;
// Repeat enough to overflow wide screens; the track is duplicated for a seamless loop.
const run = [...words, ...words, ...words];
---
<div class="marquee" aria-label={words.join(', ')} role="img">
  <div class="marquee__track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="marquee__group" role="list">
        {run.map((w) => <li>{w}</li>)}
      </ul>
    ))}
  </div>
</div>
<style>
  .marquee {
    background: var(--accent); color: var(--color-forest);
    overflow: hidden; height: clamp(44px, 4vw + 20px, 65px);
    display: flex; align-items: center;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track { display: flex; width: max-content; animation: marquee 60s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__group { display: flex; flex-shrink: 0; }
  .marquee__group li {
    font-family: var(--font-display); font-size: var(--fs-xs); white-space: nowrap;
    display: flex; align-items: center;
  }
  .marquee__group li::after { content: "•"; margin-inline: clamp(1.25rem, 3vw, 2.4rem); font-size: 0.9em; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }
</style>

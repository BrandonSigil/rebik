---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getAllWork } from '../../lib/work';
const projects = await getAllWork();
---
<Base title="Work" description="Case studies by Peter Rebik: brand systems, campaigns and digital work for Pierce Transit and freelance clients, with the results behind each one.">
  <section class="section">
    <header class="section-head container-md" data-reveal>
      <h1 class="t-display">All <span class="hl">work</span>.</h1>
      <p>A closer look at the design challenges behind each project, the thinking that shaped the solutions, and the outcomes that followed.</p>
    </header>
    <ul role="list" class="grid container">
      {projects.map((p, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <a href={`/work/${p.id}/`} class="item">
            <div class="item__media">
              <Image src={p.data.cover} alt={p.data.coverAlt} widths={[400, 720]} sizes="(max-width: 760px) 100vw, 360px" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
              {p.data.results[0] && <p class="stat"><strong>{p.data.results[0].value}</strong> {p.data.results[0].label}</p>}
            </div>
            {p.data.employer && <p class="item__employer">{p.data.employer}</p>}
            <h2 class="t-h2">{p.data.title}</h2>
            <p>{p.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <ContactCTA />
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-8) var(--space-6); }
  .item { display: grid; gap: var(--space-3); }
  .item__media { position: relative; aspect-ratio: 3 / 2; border-radius: var(--radius-md); overflow: hidden; transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .item__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .item__employer { font-family: var(--font-label); font-size: var(--fs-micro); text-transform: var(--label-case); letter-spacing: var(--label-tracking); color: var(--accent-text); margin-bottom: calc(-1 * var(--space-2)); }
  :global([data-theme="original"]) .item__employer { font-size: var(--fs-small); color: var(--color-forest); }
  .stat {
    position: absolute; left: var(--space-3); bottom: var(--space-3); max-width: calc(100% - 2 * var(--space-3));
    display: inline-flex; align-items: baseline; gap: 0.5em; padding: 0.4em 0.8em; border-radius: var(--radius-pill);
    background: var(--color-lime); color: var(--color-forest);
    font-family: var(--font-label); font-size: var(--fs-micro); text-transform: var(--label-case); letter-spacing: var(--label-tracking); line-height: 1.2;
  }
  .stat strong { font-family: var(--font-heading); font-weight: var(--heading-weight); font-size: 1.3em; text-transform: none; letter-spacing: -0.02em; }
  .item:hover .item__media { box-shadow: var(--shadow-md); transform: translateY(-4px); }
  .item:hover .item__media img { transform: scale(1.05); }
</style>
